{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IRI 2026 application",
  "type": "object",
  "properties": {
    "application": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "concept": { "type": "string", "maxLength": 5000 },
        "relevance": { "type": "string", "maxLength": 5000 },
        "expectedResults": { "type": "string", "maxLength": 5000 }
      }
    },
    "business-plan": {
      "type": "object",
      "properties": {
        "summary": { "type": "string", "maxLength": 10000 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "sum"],
            "properties": {
              "name": { "type": "string" },
              "sum": { "type": "number" },
              "comment": { "type": "string" }
            }
          }
        },
        "risks": { "type": "string", "maxLength": 5000 }
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "pdf": { "type": "string" },
        "pptx": { "type": "string" }
      }
    },
    "applicant": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "inn": { "type": "string" },
        "ogrn": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "team": {
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
