{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anything-to-git.local/schemas/adapter.schema.json",
  "title": "Anything to Git declarative site adapter",
  "type": "object",
  "required": ["id", "version", "site", "pages"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {"type": "integer", "minimum": 1},
    "site": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "start_url": {"type": "string"},
        "scope": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    },
    "merge_policies": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"enum": ["atomic", "set", "by_id"]},
          {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["atomic", "set", "by_id"]},
              "id_key": {"type": "string"}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "page": {
      "type": "object",
      "required": ["id", "blocks"],
      "additionalProperties": true,
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "title": {"type": "string"},
        "navigation": {"type": "object"},
        "save": {"type": "object"},
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/block"}
        }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "fields"],
      "additionalProperties": true,
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "title": {"type": "string"},
        "navigation": {"type": "object"},
        "save": {"type": "object"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/field"}
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "canonical", "type"],
      "additionalProperties": true,
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "label": {"type": "string"},
        "description": {"type": "string"},
        "capture_key": {"$ref": "#/$defs/safeId"},
        "canonical": {
          "type": "object",
          "required": ["file"],
          "additionalProperties": false,
          "properties": {
            "file": {"type": "string", "pattern": "\\.json$"},
            "pointer": {"type": "string"}
          }
        },
        "type": {"enum": ["string", "integer", "number", "boolean", "array", "object", "null"]},
        "required": {"type": "boolean"},
        "read": {"type": "object"},
        "write": {"type": "object"},
        "normalize": {"type": "object"},
        "constraints": {"type": "object"}
      }
    }
  }
}
